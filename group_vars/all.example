# Copy to group_vars/all or use as reference. Ubuntu 24+ only.

location: weshouse  # optional; used for docker repo override, NFS/ceph mounts, resolv.conf

# Optional: override Docker CE repo per location (otherwise official Docker repo for Ubuntu is used)
# apt_repos:
#   docker_repo:
#     weshouse: "deb [arch=amd64] https://download.docker.com/linux/ubuntu noble stable"
#     jamiehouse: "deb [arch=amd64] https://nexus.example.com/repository/docker-ubuntu/ noble stable"

# Rancher 2 agent (optional - only for hosts in [rancher2] group)
rancher2:
  weshouse: --server https://... --token ... --ca-checksum ... --worker
  jamiehouse: --server https://... --token ... --ca-checksum ... --worker

rancher2_image:
  weshouse: rancher/rancher-agent:v2.2.4
  jamiehouse: nexus.example.com/rancher/rancher-agent:v2.2.4

# NFS/ceph home dir (optional - only when location is jamiehouse)
home_dir:
  weshouse:
    path: /home/wes
    src: 172.16.1.17:/mnt/raid5_kdrive/home/wes
    fstype: nfs
    opts: ''
  jamiehouse:
    path: /home/wes
    src: 10.2.1.1:6789:/home/wes
    fstype: ceph
    opts: name=admin,secret=...,auto,nofail

# Required: crypted password for user wes (use ansible-playbook -e wes_crypted_pwd='...')
wes_crypted_pwd: "..."
